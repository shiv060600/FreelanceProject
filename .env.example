# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI contract generation (required for the "Generate with AI" feature)
OPENAI_API_KEY=
# Optional: override the model without a deploy (default: gpt-6.2-sol, ~5-8 cents per contract).
# Flagship for the hardest agreements: gpt-6.2-astra (~4x the price). Falls back automatically if unavailable.
OPENAI_CONTRACT_MODEL=
# Optional: reasoning effort for GPT-5+/GPT-6 models: medium (default) | high | xhigh | max | low
OPENAI_CONTRACT_REASONING=
# Shared secret the mobile app sends in the `expo-api-key` header
AI_CONTRACT_API_KEY=
