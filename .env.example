# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI contract generation (required for the "Generate with AI" feature)
OPENAI_API_KEY=
# Optional: override the model without a deploy (default: gpt-4.1)
OPENAI_CONTRACT_MODEL=
# Shared secret the mobile app sends in the `expo-api-key` header
AI_CONTRACT_API_KEY=
