# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI contract generation (required for the "Generate with AI" feature)
OPENAI_API_KEY=
# Optional: override the model without a deploy (default: gpt-5.4-mini).
# Higher quality: gpt-5.4 or gpt-5.6-sol. Falls back automatically if unavailable.
OPENAI_CONTRACT_MODEL=
# Optional: reasoning effort for GPT-5.x models: low (default) | medium | high
OPENAI_CONTRACT_REASONING=
# Shared secret the mobile app sends in the `expo-api-key` header
AI_CONTRACT_API_KEY=
